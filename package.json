{
  "name": "dsh-subagent-cassette",
  "version": "0.2.0",
  "description": "Deterministic VCR-style recording and replay for concurrent DeepSeek Harness subagent calls.",
  "type": "module",
  "license": "MIT",
  "author": "Linxiushen",
  "homepage": "https://github.com/Linxiushen/dsh-subagent-cassette#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linxiushen/dsh-subagent-cassette.git"
  },
  "bugs": {
    "url": "https://github.com/Linxiushen/dsh-subagent-cassette/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "subagent",
    "record-replay",
    "vcr",
    "testing",
    "agentic"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.0.0",
    "pnpm": ">=11.7.0 <12"
  },
  "packageManager": "pnpm@11.19.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dsh-cassette": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./diff": {
      "types": "./dist/diff.d.ts",
      "default": "./dist/diff.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:dist": "node tests/dist-smoke.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm test:dist && pnpm publint",
    "publint": "publint --pack=false",
    "prepack": "pnpm check"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.7",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.76.0",
    "publint": "^0.3.18",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
